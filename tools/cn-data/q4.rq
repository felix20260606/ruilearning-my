SELECT ?p ?c ?cl ?clz ?cen ?coord ?img ?zhw WHERE {
  { BIND(wd:Q57251 AS ?p) VALUES ?t { wd:Q706447 wd:Q83020 } ?c wdt:P31 ?t . }
  UNION
  { BIND(wd:Q57251 AS ?p) wd:Q865 p:P150 ?st . ?st ps:P150 ?c . FILTER NOT EXISTS { ?st pq:P582 ?e } }
  UNION
  { BIND(wd:Q14773 AS ?p) VALUES ?c { wd:Q1334373 } }
  UNION
  { BIND(wd:Q14773 AS ?p) ?c rdfs:label ?lab . VALUES ?lab { "Taipa"@en "Coloane"@en "Cotai"@en } ?c wdt:P131* wd:Q14773 . }
  FILTER NOT EXISTS { ?c wdt:P576 ?d }
  OPTIONAL { ?c rdfs:label ?cl FILTER(lang(?cl)="zh-cn") }
  OPTIONAL { ?c rdfs:label ?clz FILTER(lang(?clz)="zh") }
  OPTIONAL { ?c rdfs:label ?cen FILTER(lang(?cen)="en") }
  OPTIONAL { ?c wdt:P625 ?coord }
  OPTIONAL { ?c wdt:P18 ?img }
  OPTIONAL { ?zhw schema:about ?c ; schema:isPartOf <https://zh.wikipedia.org/> }
}
