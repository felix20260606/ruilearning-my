SELECT ?p ?c ?cl ?cen ?coord ?img ?zhw ?typeL WHERE {
  VALUES ?p { wd:Q8646 wd:Q14773 wd:Q15175 wd:Q15176 wd:Q16963 wd:Q16967 wd:Q17269 wd:Q19770 wd:Q19206 wd:Q21208 wd:Q34800 wd:Q40956 wd:Q41079 wd:Q41705 wd:Q42200 wd:Q42392 wd:Q43194 wd:Q43407 wd:Q43684 wd:Q43934 wd:Q45208 wd:Q45761 wd:Q45833 wd:Q46862 wd:Q46913 wd:Q47097 wd:Q47974 wd:Q57052 wd:Q57251 wd:Q57448 wd:Q956 wd:Q8686 wd:Q11736 wd:Q11725 }
  ?p p:P150 ?st . ?st ps:P150 ?c .
  FILTER NOT EXISTS { ?st pq:P582 ?e }
  FILTER NOT EXISTS { ?c wdt:P576 ?d }
  OPTIONAL { ?c rdfs:label ?cl FILTER(lang(?cl)="zh-cn") }
  OPTIONAL { ?c rdfs:label ?cen FILTER(lang(?cen)="en") }
  OPTIONAL { ?c wdt:P625 ?coord }
  OPTIONAL { ?c wdt:P18 ?img }
  OPTIONAL { ?zhw schema:about ?c ; schema:isPartOf <https://zh.wikipedia.org/> }
  OPTIONAL { ?c wdt:P31 ?t . ?t rdfs:label ?typeL FILTER(lang(?typeL)="zh-cn") }
}
