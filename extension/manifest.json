{
  "manifest_version": 3,
  "name": "双语字幕 · 生词收集",
  "version": "1.28.0",
  "description": "YouTube / 哔哩哔哩双语字幕、悬停查词、字幕列表、单句循环，一键把生词收进你的生词本。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://en.wiktionary.org/*",
    "https://api.datamuse.com/*",
    "https://tatoeba.org/*",
    "https://ssl.gstatic.com/*",
    "https://ruilearning-my.pages.dev/*",
    "https://dict.youdao.com/*",
    "https://api.mymemory.translated.net/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "双语字幕设置",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "bili-inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "freq.js",
        "vlevel.js",
        "gram.js",
        "pattern.js",
        "data-phrases.js",
        "data-words.js",
        "data-morph.js",
        "notes.js",
        "sites.js",
        "content.js",
        "work.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ruilearning-my.pages.dev/*",
        "http://localhost/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.bilibili.com/*",
        "https://ruilearning-my.pages.dev/*",
        "https://*.ruilearning-my.pages.dev/*",
        "https://music.youtube.com/*",
        "https://m.bilibili.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "freq.js",
        "vlevel.js",
        "page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "level.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*"
      ]
    },
    {
      "resources": [
        "saved.html"
      ],
      "matches": [
        "https://ruilearning-my.pages.dev/*",
        "http://localhost/*"
      ]
    }
  ]
}
